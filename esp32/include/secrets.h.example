// Copy this file to /include/secrets.h and fill in real values
//
// GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET / GOOGLE_REFRESH_TOKEN: copy these
// straight out of the desktop build's .env after running `./health_tracker
// --auth` there. The device only ever uses the refresh-token flow — it never
// does the browser consent step itself.

#pragma once

#define WIFI_SSID "your-wifi-ssid"
#define WIFI_PASSWORD "your-wifi-password"

#define GOOGLE_CLIENT_ID "your-client-id.apps.googleusercontent.com"
#define GOOGLE_CLIENT_SECRET "your-client-secret"
#define GOOGLE_REFRESH_TOKEN "your-refresh-token"

// timezone example: US Eastern is -5*3600 standard time.
#define GMT_OFFSET_SEC (-5 * 3600)
// Extra offset applied during daylight saving time; set to 0 if your region
// doesn't observe DST.
#define DAYLIGHT_OFFSET_SEC 3600
